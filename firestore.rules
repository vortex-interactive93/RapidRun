// File: firestore.rules
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS
    // =========================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        ('email' in request.auth.token && request.auth.token.email.matches('.*@rapidrun[.]com$'))
      );
    }

    // =========================================================================
    // 1. PUBLIC IN-STORE CATALOG & REAL-TIME INVENTORY (Pluck Powered)
    // =========================================================================
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    match /stores/{storeId} {
      allow read: if true;
      allow write: if isAdmin() || isAuthenticated() || true;
    }

    match /zones/{zoneId} {
      allow read: if true;
      allow write: if isAdmin() || isAuthenticated() || true;
    }

    // =========================================================================
    // 2. USERS & CUSTOMERS (Supports Anonymous Sessions & Profiles)
    // =========================================================================
    match /users/{userId} {
      allow read, write: if true;
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    match /customers/{customerId} {
      allow read, write: if true;
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // =========================================================================
    // 3. DRIVER PROFILES, TELEMETRY & SHIFT STATUS
    // =========================================================================
    match /drivers/{driverId} {
      allow read, write: if true;
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // =========================================================================
    // 4. LIVE ORDERS, DISPATCH STREAM & IN-ORDER COURIER CHAT 💬⚡
    // =========================================================================
    match /orders/{orderId} {
      allow read, write: if true;
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }
  }
}
