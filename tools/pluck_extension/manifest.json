{
  "manifest_version": 3,
  "name": "Pluck 3.0 - RapidRun BBW Exporter",
  "version": "3.0.0",
  "description": "Extracts & hydrates full Bath & Body Works catalogs for RapidRun.",
  "permissions": [
    "activeTab",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.bathandbodyworks.com/*"
      ],
      "js": ["content.js"],
      "css": ["style.css"]
    }
  ]
}
