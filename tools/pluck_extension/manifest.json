{
  "manifest_version": 3,
  "name": "Pluck 4.0 - RapidRun Multi-Store Exporter",
  "version": "4.0.0",
  "description": "Extracts & hydrates Bath & Body Works and ALDI catalogs for RapidRun.",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel",
    "tabs"
  ],
  "host_permissions": [
    "*://*.bathandbodyworks.com/*",
    "*://*.aldi.us/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "action": {
    "default_title": "Open Pluck Panel",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.bathandbodyworks.com/*",
        "*://*.aldi.us/*"
      ],
      "js": ["content.js"]
    }
  ]
}
